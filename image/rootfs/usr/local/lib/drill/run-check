#!/bin/bash
# root: run the scenario's check.sh and record the outcome
# (drill.sh reads /var/lib/drill/{checks,solved,hints,peeked} via drill-report: keep their meaning)
S=/var/lib/drill
DRILL_COLOR=1 . /usr/local/lib/drill/ui.sh
now=$(date +%s); start=$(cat $S/start 2>/dev/null || echo "$now")
fmt() { printf '%d:%02d' $(($1 / 60)) $(($1 % 60)); }
n=$(grep -c . $S/checks 2>/dev/null); n=$(( ${n:-0} + 1 ))
UI_C=$BLU
ui_top "CHECK  attempt $n" "elapsed $(fmt $((now - start)))" | sed "s/╮/─/; s/╭/─/"
if bash /drill/check.sh; then rc=0; else rc=1; fi
echo "$now $([ $rc = 0 ] && echo PASS || echo FAIL)" >> $S/checks
if [ $rc = 0 ]; then
  [ -f $S/solved ] || echo "$now" > $S/solved
  secs=$(( $(cat $S/solved) - start )); t=$(fmt $secs)
  h=$(cat $S/hints 2>/dev/null || echo 0); c=$(grep -c . $S/checks)
  ht=$(grep -c . /drill/hints.txt 2>/dev/null || echo 3)
  lvl=$(. /drill/meta.env 2>/dev/null; echo "${LEVEL:-1}")
  xp=$(( lvl * 100 - h * 25 )); [ $xp -lt 25 ] && xp=25; [ -f $S/peeked ] && xp=10
  G=$'\e[1;32m' Y=$'\e[1;33m'
  echo
  printf '%s' "$G"
  cat <<'ART'
     ____   ___  _    __     _______ ____    _
    / ___| / _ \| |   \ \   / / ____|  _ \  | |
    \___ \| | | | |    \ \ / /|  _| | | | | | |
     ___) | |_| | |___  \ V / | |___| |_| | |_|
    |____/ \___/|_____|  \_/  |_____|____/  (_)
ART
  printf '%s\n' "$R"
  msg="clean solve, no hints"; [ "$h" -gt 0 ] && msg="solved with $h hint$([ "$h" = 1 ] || echo s)"
  [ -f $S/peeked ] && msg="solved after peeking at the solution"
  [ "$c" = 1 ] && [ "$h" = 0 ] && msg="first-try check, no hints. Textbook."
  printf '    %stime%s %s%-7s%s %shints%s %s%-4s%s %schecks%s %s%-4s%s %sworth%s %s+%d XP%s\n' \
    "$D" "$R" "$B" "$t" "$R" "$D" "$R" "$B" "$h/$ht" "$R" "$D" "$R" "$B" "$c" "$R" "$D" "$R" "$Y" "$xp" "$R"
  printf '    %s%s%s\n\n' "$G" "$msg" "$R"
  echo "    solution  = the ideal path + your weak-spot report"
  echo "    next      = log this one and start the next drill"
  echo "    exit      = log this one and stop"
else
  case $(( (n - 1) % 5 )) in
    0) tip="Good: now you know what broken looks like. Read the red lines." ;;
    1) tip="Each red line says what check SAW. Make one of them go green first." ;;
    2) tip="Step back: what changed, and does the fix survive a restart?" ;;
    3) tip="Run the 60-second sweep again (playbook): fresh eyes, same box." ;;
    4) tip="Slow is smooth. Say out loud what you expect, then look." ;;
  esac
  printf '\n  %sNot fixed yet%s  %selapsed %s  attempt %d%s\n  %s%s%s  %sstuck? hint%s\n' \
    "$B$YEL" "$R" "$D" "$(fmt $((now - start)))" "$n" "$R" "" "$tip" "" "$D" "$R"
fi
exit $rc
