# ---------------------------------------------------------------- output helpers
def out(s=""):
    sys.stdout.write(s + "\n")


def err(s=""):
    sys.stdout.flush()
    sys.stderr.write(s + "\n")
    sys.stderr.flush()


def die(msg, rc=1):
    err(msg)
    sys.exit(rc)


# ---------------------------------------------------------------- default (healthy) state
def perm_map(normal, runtime):
    m = {}
    for p in normal:
        m[p] = {"granted": True, "runtime": False, "flags": ""}
    for p, g in runtime:
        m[p] = {"granted": g, "runtime": True, "flags": "USER_SET" if g else ""}
    return m


def mkpkg(uid, ver, code, normal=(), runtime=(), system=False, persistent=False, requires=(), running=False, pid=0):
    return {"system": system, "uid": uid, "version": ver, "code": code, "persistent": persistent,
            "requires": list(requires), "running": running, "pid": pid, "next_restart": None,
            "restart_delay": 1, "last_attempt": None, "last_pid": 0, "crashes": 0, "enabled": True,
            "permissions": perm_map(normal, runtime)}


