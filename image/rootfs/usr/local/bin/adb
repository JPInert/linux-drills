# ---------------------------------------------------------------- state store
def deep_merge(base, over):
    for k, v in over.items():
        if isinstance(v, dict) and isinstance(base.get(k), dict):
            deep_merge(base[k], v)
        else:
            base[k] = v
    return base


def load_state(now):
    st = default_state()
    try:
        with open(STATE_FILE) as f:
            deep_merge(st, json.load(f))
    except (OSError, ValueError):
        pass
    if st["hub"].get("boot_epoch") is None:
        st["hub"]["boot_epoch"] = now - 3 * 86400 - 5400
    return st


class Store(object):
    @contextlib.contextmanager
    def tx(self, tick=True):
        try:
            os.makedirs(STATE_DIR, 0o700, exist_ok=True)
            fd = os.open(LOCK_FILE, os.O_CREAT | os.O_RDWR, 0o600)
        except OSError:
            fd = None
        if fd is not None:
            fcntl.flock(fd, fcntl.LOCK_EX)
        now = time.time()
        st = load_state(now)
        st["_now"] = now
        try:
            if tick:
                do_tick(st, now)
            yield st
        except KeyboardInterrupt:
            raise
        finally:
            st.pop("_now", None)
            try:
                tmp = STATE_FILE + ".tmp"
                with open(tmp, "w") as f:
                    json.dump(st, f, indent=1, sort_keys=True)
                os.replace(tmp, STATE_FILE)
            except OSError:
                pass
            if fd is not None:
                fcntl.flock(fd, fcntl.LOCK_UN)
                os.close(fd)


STORE = Store()


# ---------------------------------------------------------------- logcat buffers
LOG_RE = re.compile(r"^(\d\d-\d\d \d\d:\d\d:\d\d\.\d{3})\s+(\d+)\s+(\d+)\s+([VDIWEFA])\s+(.*?)\s*:\s?(.*)$")


def logpath(buf):
    return "%s/logcat.%s.txt" % (STATE_DIR, buf)


def fmt_ts(t):
    return time.strftime("%m-%d %H:%M:%S", time.localtime(t)) + ".%03d" % int((t % 1) * 1000)


def write_log(buf, t, pid, tid, lvl, tag, msg):
    line = "%s %5d %5d %s %-8s: %s\n" % (fmt_ts(t), pid, tid, lvl, tag, msg)
    try:
        with open(logpath(buf), "a") as f:
            f.write(line)
        if os.path.getsize(logpath(buf)) > 900000:
            keep = read_log_raw(buf)[-4000:]
            with open(logpath(buf), "w") as f:
                f.write("\n".join(keep) + "\n")
    except OSError:
        pass


def read_log_raw(buf):
    try:
        with open(logpath(buf)) as f:
            return [ln.rstrip("\n") for ln in f]
    except OSError:
        return []


def parse_entries(buf):
    res = []
    for ln in read_log_raw(buf):
        m = LOG_RE.match(ln)
        if m:
            res.append((m.group(1), int(m.group(2)), int(m.group(3)), m.group(4), m.group(5), m.group(6), buf))
        elif ln.strip():
            res.append(("", 0, 0, "V", "", ln, buf))
    return res


